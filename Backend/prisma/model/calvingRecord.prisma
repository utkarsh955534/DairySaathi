model CalvingRecord {
  id Int @id @default(autoincrement())

  motherId Int
  calfId Int?

  calvingDate DateTime

  notes String?

  createdAt DateTime @default(now())

  mother Animal @relation("MotherCalvings", fields: [motherId], references: [id], onDelete: Cascade)

  calf Animal? @relation("CalvingCalf", fields: [calfId], references: [id], onDelete: SetNull)

  @@index([motherId])
  @@index([calfId])
  @@index([calvingDate])
}