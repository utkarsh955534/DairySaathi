model MilkRecord {
  id Int @id @default(autoincrement())

  animalId Int

  recordDate DateTime

  morning Float?
  evening Float?

  total Float

  notes String?

  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([animalId, recordDate])
  @@index([animalId])
  @@index([recordDate])
}